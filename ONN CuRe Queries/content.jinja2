USE CATALOG {{ q.uc_catalog }};

DROP TABLE IF EXISTS {{ q.target_table }};

CREATE TABLE IF NOT EXISTS {{ q.target_table }} (
    {{ q.columns_create|join(', ') }}
    );

INSERT INTO {{ q.target_table }} (
    {{ q.columns_insert|join(', \n    ') }}
)
SELECT /*+ BROADCAST(cid) */  DISTINCT
    {{ q.columns_select|join(', \n    ') }}
FROM (
    SELECT viz.* FROM {{ q.uc_catalog }}.detection.viewing_content_golden AS viz
    WHERE 'VIZIO' IN ('VIZIO')              -- If only Vizio
    -- WHERE 'VIZIO' IN ('ONN')             -- If only ONN
    -- WHERE 'VIZIO' IN ('VIZIO', 'ONN')    -- If both Vizio and ONN
      AND viz.session_start >= {{ q.ts_start }}
      AND viz.session_start < {{ q.ts_end }}
      AND viz.session_start_hour >= DATE_TRUNC('HOUR', {{ q.ts_start }})
      AND viz.session_start_hour <= DATE_TRUNC('HOUR', {{ q.ts_end }})
    UNION
    SELECT onn.* FROM {{ q.uc_catalog }}.detection_onn.viewing_content_golden AS onn
    WHERE 'ONN' IN ('VIZIO')              -- If only Vizio
    -- WHERE 'ONN' IN ('ONN')             -- If only ONN
    -- WHERE 'ONN' IN ('VIZIO', 'ONN')    -- If both Vizio and ONN
      AND onn.session_start >= {{ q.ts_start }}
      AND onn.session_start < {{ q.ts_end }}
      AND onn.session_start_hour >= DATE_TRUNC('HOUR', {{ q.ts_start }})
      AND onn.session_start_hour <= DATE_TRUNC('HOUR', {{ q.ts_end }})
) AS mt
    JOIN prod.detection.tv_populations AS u
        ON mt.fk_tvid = u.fk_tvid
    JOIN prod.detection.populations AS pop
        ON u.fk_population_id = pop.population_id 
        AND pop.population_name = 'opted_in'
{% if df.CO_VIEWING_FACTORS in q.columns %}
    LEFT OUTER JOIN prod.demographics.viewing_content_demographics_firehose dmg
        ON mt.fk_tvid = dmg.fk_tvid
        AND mt.session_start = dmg.session_start
WHERE 1=1
{% if q.TYPE == rt.CONTENT %}
      AND mt.content_only_condition = FALSE
      AND CASE WHEN '{client_name}' != 'nielsen' AND mt.nielsen_exclusive THEN FALSE ELSE TRUE END
      AND CASE WHEN mt.client_id_not_null != '||' AND mt.client_id_not_null NOT LIKE '%|{client_name}|%' THEN FALSE ELSE TRUE END
      AND CASE WHEN mt.acrb_clients NOT IN ('||', '|ALL|') AND mt.acrb_clients NOT LIKE '%|{client_name}|%' THEN FALSE ELSE TRUE END
      AND CASE WHEN mt.acrb_clients <=> '|ALL|' AND NOT('{app_toggle}' <=> NVL(mt.app_service, '98989898')) THEN FALSE ELSE TRUE END
      AND CASE WHEN {vod_toggle} = FALSE AND mt.vod_station = TRUE THEN FALSE ELSE TRUE END
    {% endif %}
{% endif %}
    {{ q.custom_clause }}
{% if q.sample_size != False %}
    AND MOD(mt.fk_tvid, 100) < {{q.sample_size}}
{% endif %}