
USE CATALOG {{ q.uc_catalog }};

{% if q.use_view == false %}

DROP TABLE IF EXISTS {{ q.target_table }};

CREATE TABLE IF NOT EXISTS {{ q.target_table }} (
    {{ q.columns_create|join(', ') }}
    );

INSERT INTO {{ q.target_table }} (
    {{ q.columns_insert|join(', \n    ') }}
)

{% elif q.use_view == true and q.alter_view == false  %}


CREATE SCHEMA IF NOT EXISTS cure_deltashare.{client_name};

DROP VIEW IF EXISTS {{ q.target_table }};

CREATE VIEW {{ q.target_table }} AS

{% elif q.use_view == true and q.alter_view == true %}

ALTER VIEW {{ q.target_table }} AS

{% endif %}
{% if 'VIZIO' in q.oem %}
SELECT /*+ BROADCAST(wfd_check) 
      SHUFFLE_HASH(hashed_table)   
         */
DISTINCT
    {{ q.columns_select|join(', \n    ') }}
    FROM (
        SELECT viz.* FROM {{ q.uc_catalog }}.detection.viewing_commercials_cfe_golden AS viz
        WHERE
{% if q.use_view == true %}
        viz.session_start between (current_date - INTERVAL '6' MONTH) AND

{% if q.TYPE == rt.COMMERCIALFEEDMODULAR %} 
        (current_timestamp - INTERVAL '{{q.mod_interval}}' DAY)
{% else %}
        current_timestamp
{% endif %}           

{% elif q.use_view == false %} 
            viz.session_start >= {{ q.ts_start }}
            AND viz.session_start < {{ q.ts_end }}
            AND viz.session_start_hour >= {{ q.ts_start }}
            AND viz.session_start_hour < {{ q.ts_end }}
{% endif %}  
            AND CASE WHEN (viz.acrb_clients IS NOT NULL
            AND viz.acrb_clients != '||'
            AND viz.acrb_clients NOT LIKE '%|{{ q.customer.name }}|%') OR viz.acrb_clients <=> '|ALL|' THEN FALSE ELSE TRUE END
{% endif %}

{% if 'ONN' in q.oem and 'VIZIO' in q.oem %}
    UNION
{% endif %}

{% if 'ONN' in q.oem %}
        SELECT onn.* FROM {{ q.uc_catalog }}.detection_onn.viewing_commercials_cfe_golden AS onn
        WHERE 
{% if q.use_view == true %}
        onn.session_start between (current_date - INTERVAL '6' MONTH) AND

{% if q.TYPE == rt.COMMERCIALFEEDMODULAR %} 
        (current_timestamp - INTERVAL '{{q.mod_interval}}' DAY)
{% else %}
        current_timestamp
{% endif %} 

{% elif q.use_view == false %} 
            onn.session_start >= {{ q.ts_start }}
            AND onn.session_start < {{ q.ts_end }}
            AND onn.session_start_hour >= {{ q.ts_start }}
            AND onn.session_start_hour < {{ q.ts_end }}
{% endif %}          
            AND CASE WHEN (onn.acrb_clients IS NOT NULL
            AND onn.acrb_clients != '||'
            AND onn.acrb_clients NOT LIKE '%|{{ q.customer.name }}|%') OR onn.acrb_clients <=> '|ALL|' THEN FALSE ELSE TRUE END
{% endif %}
    ) AS mt
    JOIN {{ q.uc_catalog }}.detection.tv_populations AS tp
        ON mt.fk_tvid = tp.fk_tvid
    JOIN {{ q.uc_catalog }}.detection.populations AS pop
        ON tp.fk_population_id = pop.population_id
        AND LOWER(pop.population_name) = 'opted_in'

{% if q.use_view == true %}
    JOIN ( SELECT DISTINCT * FROM {{ q.hashes_table }} ) AS hashed_table 
        ON mt.tvid = hashed_table.tvid
    JOIN {{ q.uc_catalog }}.customer_reports.wfd_watermark as wfd_check
        ON wfd_check.report_type = 'commercial_dedup'
        AND wfd_check.frequency = 'hourly'
        AND mt.session_start_hour = date_format(wfd_check.start_ts, 'yyyy-MM-dd HH:mm:ss')
        AND wfd_check.start_ts between (current_date - INTERVAL '6' MONTH) and current_timestamp
{% endif %}   

    WHERE
        1=1

{% if q.TYPE == rt.COMMERCIALFEEDMODULAR %} 
        AND fk_commercial_source_id IN {{ q.feed_source_id }}
{% endif %}
        {{ q.custom_clause }}
{% if q.sample_size != False %}
        AND MOD(mt.fk_tvid, 100) < {{q.sample_size}};
{% endif %}
