    "%sql\n",
    "SELECT viewing_type, COUNT(*), COUNT(DISTINCT ad_id) FROM (\n",
    "SELECT *, DENSE_RANK() OVER (PARTITION BY viewing_type ORDER BY impression_count DESC) AS rk\n",
    "FROM dev.mohit_gangwani.ad_viewing_type_dma_overall)\n",
    "WHERE rk <= 10000\n",
    "GROUP BY 1"
   ]
  },
